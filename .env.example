AUTH_URL="http://localhost:3000"
# OAuth providers (optional; add the ones you use)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# â”€â”€ Lead data providers (server-side only â€” NEVER expose to the browser) â”€â”€â”€â”€â”€â”€â”€
# Google Places API (New) key for real discovery. GOOGLE_PLACES_API_KEY is the
# canonical name; GOOGLE_MAPS_API_KEY is accepted as a backward-compatible
# fallback (used only if GOOGLE_PLACES_API_KEY is blank/unset). Enable the
# "Places API (New)" and billing in Google Cloud, and restrict the key to that
# API. When neither is set, discovery falls back to the dev mock provider.
GOOGLE_PLACES_API_KEY=""
GOOGLE_MAPS_API_KEY=""
APIFY_API_KEY=""
# Dev-only mock provider. Must be false/unset in production.
ENABLE_MOCK_PROVIDER="true"
# Real homepage enrichment (server-side, homepage-only, no external API). When
# "true", the enrichment worker fetches each lead's website and extracts a
# contact email + social links. Off by default; when false/unset the enrichment
# worker uses the mock provider (fills nothing).
ENABLE_WEBSITE_ENRICHMENT="false"

# â”€â”€ Enrichment / AI â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
