# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadforge"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"

# ── Auth (Auth.js / NextAuth v5) ──────────────────────────────────────────────
AUTH_SECRET=""              # generate: openssl rand -base64 32
AUTH_URL="http://localhost:3000"
# OAuth providers (optional; add the ones you use)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Lead data providers (server-side only — NEVER expose to the browser) ───────
GOOGLE_MAPS_API_KEY=""
APIFY_API_KEY=""
# Dev-only mock provider. Must be false/unset in production.
ENABLE_MOCK_PROVIDER="true"

# ── Enrichment / AI ───────────────────────────────────────────────────────────
OPENAI_API_KEY=""

# ── Stripe (§19) ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_AGENCY=""

# ── Google Sheets OAuth (§16) ─────────────────────────────────────────────────
GOOGLE_SHEETS_CLIENT_ID=""
GOOGLE_SHEETS_CLIENT_SECRET=""
GOOGLE_SHEETS_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# ── Encryption for stored integration tokens (§17, §28) ───────────────────────
# 32-byte key, base64. Used to encrypt Integration.encryptedCredentials at rest.
ENCRYPTION_KEY=""

# ── Email (§3 password reset / verification) ──────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="LeadForge AI <noreply@leadforge.ai>"
